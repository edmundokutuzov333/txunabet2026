rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isCompanyMember(companyId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId)
        && firestore.get(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function hasConversationAccess(companyId, conversationId) {
      return isCompanyMember(companyId)
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.companyId == companyId
        && (firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.type == 'company_general'
          || (firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.type == 'department'
            && firestore.exists(/databases/(default)/documents/departments/$(firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.departmentId)/members/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/departments/$(firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.departmentId)/members/$(request.auth.uid)).data.status == 'active')
          || (firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.type in ['direct', 'group']
            && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds));
    }
    function validUpload() { return request.resource != null && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024; }

    match /companies/{companyId}/users/{userId}/avatars/{fileName} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) && (request.auth.uid == userId || isCompanyAdmin(companyId)) && validUpload() && request.resource.contentType.matches('image/.*');
      allow delete: if isCompanyMember(companyId) && (request.auth.uid == userId || isCompanyAdmin(companyId));
    }
    match /companies/{companyId}/users/{userId}/files/{allPaths=**} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) && (request.auth.uid == userId || isCompanyAdmin(companyId)) && validUpload();
      allow delete: if isCompanyMember(companyId) && (request.auth.uid == userId || isCompanyAdmin(companyId));
    }
    match /companies/{companyId}/conversations/{conversationId}/attachments/{userId}/{allPaths=**} {
      allow read: if hasConversationAccess(companyId, conversationId);
      allow write: if hasConversationAccess(companyId, conversationId) && request.auth.uid == userId && validUpload();
      allow delete: if hasConversationAccess(companyId, conversationId) && (request.auth.uid == userId || isCompanyAdmin(companyId));
    }
    match /companies/{companyId}/documents/{documentId}/{allPaths=**} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId) && validUpload();
      allow delete: if isCompanyMember(companyId);
    }
  }
}
