rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      return signedIn() && request.auth.token.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId) && request.auth.token.role in ['owner', 'admin'];
    }

    function validUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024;
    }

    match /companies/{companyId}/users/{userId}/avatars/{fileName} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId)
        && (request.auth.uid == userId || isCompanyAdmin(companyId))
        && validUpload()
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCompanyMember(companyId)
        && (request.auth.uid == userId || isCompanyAdmin(companyId));
    }

    match /companies/{companyId}/users/{userId}/files/{allPaths=**} {
      allow read: if isCompanyMember(companyId);
      allow write: if isCompanyMember(companyId)
        && (request.auth.uid == userId || isCompanyAdmin(companyId))
        && validUpload();
      allow delete: if isCompanyMember(companyId)
        && (request.auth.uid == userId || isCompanyAdmin(companyId));
    }

    match /companies/{companyId}/conversations/{conversationId}/attachments/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId) && validUpload();
      allow delete: if isCompanyMember(companyId);
    }

    match /companies/{companyId}/documents/{documentId}/{allPaths=**} {
      // Document-level ACL is enforced server-side before signed URLs are issued.
      allow read, write: if isCompanyMember(companyId) && validUpload();
      allow delete: if isCompanyMember(companyId);
    }
  }
}
