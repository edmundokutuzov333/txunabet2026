    "@types/react-dom": "^19",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "firebase-functions": "^7.0.2",
    "firebase-functions-test": "^5.0.1",
    "genkit-cli": "^1.21.0"
  }
