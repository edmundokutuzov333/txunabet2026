{
  "name": "enterprise-command",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10",
  "scripts": {
    "dev": "next dev -p 3000",
    "genkit:dev": "genkit start --tsx src/ai/dev.ts",
    "genkit:watch": "genkit start --tsx --watch src/ai/dev.ts",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:contract": "tsx --test tests/contract/*.test.ts",
    "test:rules": "tsx --test tests/rules/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.21.0",
    "@genkit-ai/next": "^1.21.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.5",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.11",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tiptap/react": "^3.40.2",
    "@tiptap/starter-kit": "^3.39.1",
    "@tiptap/extension-image": "^3.36.2",
    "@tiptap/extension-link": "^3.36.2",
    "@tiptap/extension-table": "^3.36.2",
    "@tiptap/extension-table-cell": "^3.36.2",
    "@tiptap/extension-table-header": "^3.36.2",
    "@tiptap/extension-table-row": "^3.36.2",
    "@tiptap/extension-underline": "^3.36.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.2",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.1.0",
    "framer-motion": "^12.23.17",
    "genkit": "^1.21.0",
    "lucide-react": "^0.468.0",
    "next": "15.2.4",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.0",
